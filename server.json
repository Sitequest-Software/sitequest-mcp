{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "quest.site/sitequest-hosting",
  "title": "Sitequest Hosting",
  "description": "VPS, webspaces, domains and DNS in EU datacenters, managed over MCP.",
  "version": "1.1.0",
  "websiteUrl": "https://site.quest/en/api-mcp/",
  "repository": {
    "url": "https://github.com/Sitequest-Software/sitequest-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://site.quest/pwa-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://site.quest/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "API key from the Sitequest dashboard (API / MCP), sent as a Bearer token.",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "API key with the sq_live_ prefix. Its scopes decide which tools are listed.",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
