{
  "servers": {
    "sitequest": {
      "type": "http",
      "url": "https://hosting.site.quest/mcp",
      "headers": {
        "Authorization": "Bearer ${input:sitequest-api-key}"
      }
    }
  },
  "inputs": [
    {
      "id": "sitequest-api-key",
      "type": "promptString",
      "description": "Sitequest API key (starts with sq_live_)",
      "password": true
    }
  ]
}
